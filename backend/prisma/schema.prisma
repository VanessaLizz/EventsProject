generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ======================================================
// USUÁRIOS
// ======================================================

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         String @default("CLIENT") // ORGANIZER, CLIENT, CHECKIN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           Event[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
}

// ======================================================
// CATEGORIAS GLOBAIS DE EVENTOS
// ======================================================
//
// Exemplos:
// SHOWS E FESTAS
// CINEMA
// TEATRO E ESPETACULOS
// LITERATURA | LANCAMENTOS
//
// Novas opções poderão ser criadas posteriormente.
// normalizedName impede duplicidades.
// ======================================================

model EventCategoryTemplate {
  id             String  @id @default(uuid())
  name           String
  normalizedName String  @unique
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

// ======================================================
// SETORES GLOBAIS
// ======================================================
//
// Exemplos:
// PISTA
// CAMAROTE
// CADEIRA SUPERIOR
// LOUNGE VIP
//
// São templates globais reutilizáveis.
// ======================================================

model SectorTemplate {
  id             String  @id @default(uuid())
  name           String
  normalizedName String  @unique
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventSectors EventSector[]
}

// ======================================================
// MODALIDADES GLOBAIS
// ======================================================
//
// Exemplos:
// NORMAL
// OPEN BAR
// OPEN FOOD
// OPEN BAR + FOOD
// AUTOGRAFO + LIVRO
//
// São independentes dos setores.
// ======================================================

model ModalityTemplate {
  id             String  @id @default(uuid())
  name           String
  normalizedName String  @unique
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventModalities EventSectorModality[]
}

// ======================================================
// GRUPOS DE COTA
// ======================================================
//
// Exemplo:
//
// MEIA ENTRADA
// maxPercentage = 50
//
// MEIA + MEIA SOCIAL não poderão ultrapassar
// conjuntamente 50% da capacidade aplicável.
// ======================================================

model PriceQuotaGroup {
  id             String  @id @default(uuid())
  name           String
  normalizedName String  @unique
  maxPercentage  Int
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceCategories PriceCategoryTemplate[]
}

// ======================================================
// CATEGORIAS GLOBAIS DE PREÇO
// ======================================================
//
// Exemplos:
// INTEIRA
// MEIA
// MEIA SOCIAL
// VALOR UNICO
//
// Não possuem estoque próprio.
// ======================================================

model PriceCategoryTemplate {
  id             String  @id @default(uuid())
  name           String
  normalizedName String  @unique
  isActive       Boolean @default(true)

  quotaGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotaGroup PriceQuotaGroup? @relation(fields: [quotaGroupId], references: [id])

  ticketCategories EventTicketCategory[]

  @@index([quotaGroupId])
}

// ======================================================
// EVENTOS
// ======================================================

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  // LOCAL, TICKETMASTER ou TMDB
  source String @default("LOCAL")

  externalId String?
  imageUrl   String?

  // Pode permanecer vazio enquanto o evento estiver em DRAFT.
  // A publicação exigirá capacidade válida.
  capacity Int?

  // Localização estruturada.
  // Pode permanecer incompleta durante o rascunho.
  venueName String?
  address   String?
  city      String?
  state     String?
  country   String @default("BR")

  latitude  Float?
  longitude Float?

  // Pode permanecer vazio durante o rascunho.
  // Ex.: filme importado do TMDb ainda não possui
  // data da sessão definida pelo organizador.
  dateTime DateTime?

  // DRAFT, PUBLISHED, CANCELLED
  status String @default("DRAFT")

  organizerId        String
  categoryTemplateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer        User                   @relation(fields: [organizerId], references: [id])
  categoryTemplate EventCategoryTemplate? @relation(fields: [categoryTemplateId], references: [id])

  sectors EventSector[]

  @@index([organizerId])
  @@index([categoryTemplateId])
  @@index([city])
  @@index([dateTime])
  @@index([source])

  // Impede que o mesmo organizador importe
  // duas vezes o mesmo item da mesma fonte.
  @@unique([organizerId, source, externalId])
}

// ======================================================
// SETORES CONFIGURADOS NO EVENTO
// ======================================================
//
// O template é global, porém capacidade e configuração
// pertencem especificamente ao evento.
// ======================================================

model EventSector {
  id String @id @default(uuid())

  eventId          String
  sectorTemplateId String

  capacity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectorTemplate SectorTemplate @relation(fields: [sectorTemplateId], references: [id])

  modalities EventSectorModality[]

  @@unique([eventId, sectorTemplateId])
  @@index([eventId])
  @@index([sectorTemplateId])
}

// ======================================================
// MODALIDADES DENTRO DO SETOR
// ======================================================
//
// Exemplo:
//
// CAMAROTE
// ├── NORMAL
// ├── OPEN BAR
// ├── OPEN FOOD
// └── OPEN BAR + FOOD
//
// occupancyMode:
//
// SEAT     = lugares marcados
// QUANTITY = controle somente por quantidade
// ======================================================

model EventSectorModality {
  id String @id @default(uuid())

  eventSectorId      String
  modalityTemplateId String

  capacity      Int
  occupancyMode String @default("QUANTITY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventSector      EventSector      @relation(fields: [eventSectorId], references: [id], onDelete: Cascade)
  modalityTemplate ModalityTemplate @relation(fields: [modalityTemplateId], references: [id])

  ticketCategories EventTicketCategory[]
  batches          TicketBatch[]
  seats            Seat[]

  @@unique([eventSectorId, modalityTemplateId])
  @@index([eventSectorId])
  @@index([modalityTemplateId])
}

// ======================================================
// CATEGORIAS COMERCIAIS DA MODALIDADE
// ======================================================
//
// Não possuem quantidade individual.
//
// INTEIRA, MEIA e MEIA SOCIAL compartilham
// o estoque da modalidade/lote.
// ======================================================

model EventTicketCategory {
  id String @id @default(uuid())

  eventSectorModalityId   String
  priceCategoryTemplateId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventSectorModality   EventSectorModality   @relation(fields: [eventSectorModalityId], references: [id], onDelete: Cascade)
  priceCategoryTemplate PriceCategoryTemplate @relation(fields: [priceCategoryTemplateId], references: [id])

  batchPrices TicketBatchPrice[]

  @@unique([eventSectorModalityId, priceCategoryTemplateId])
  @@index([eventSectorModalityId])
  @@index([priceCategoryTemplateId])
}

// ======================================================
// LOTES
// ======================================================
//
// O lote possui estoque compartilhado.
//
// Exemplo:
//
// PISTA = 800
//
// LOTE 1 = 400
// LOTE 2 = 400
// ======================================================

model TicketBatch {
  id String @id @default(uuid())

  eventSectorModalityId String

  name           String
  normalizedName String

  sequence Int
  quantity Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventSectorModality EventSectorModality @relation(fields: [eventSectorModalityId], references: [id], onDelete: Cascade)

  prices TicketBatchPrice[]

  @@unique([eventSectorModalityId, normalizedName])
  @@unique([eventSectorModalityId, sequence])
  @@index([eventSectorModalityId])
}

// ======================================================
// PREÇOS POR CATEGORIA DENTRO DO LOTE
// ======================================================
//
// Exemplo:
//
// LOTE 1
//
// INTEIRA      R$ 220
// MEIA         R$ 110
// MEIA SOCIAL  R$ 140
//
// Todos compartilham a quantidade do lote.
// ======================================================

model TicketBatchPrice {
  id String @id @default(uuid())

  ticketBatchId         String
  eventTicketCategoryId String

  // Valor sempre armazenado em centavos.
  priceInCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketBatch         TicketBatch         @relation(fields: [ticketBatchId], references: [id], onDelete: Cascade)
  eventTicketCategory EventTicketCategory @relation(fields: [eventTicketCategoryId], references: [id], onDelete: Cascade)

  tickets       Ticket[]
  checkoutItems CheckoutItem[]

  @@unique([ticketBatchId, eventTicketCategoryId])
  @@index([ticketBatchId])
  @@index([eventTicketCategoryId])
}

// ======================================================
// ASSENTOS
// ======================================================
//
// O assento pertence à modalidade.
//
// Apenas modalidades com occupancyMode = SEAT
// deverão possuir assentos.
// ======================================================

model Seat {
  id String @id @default(uuid())

  eventSectorModalityId String

  label           String
  normalizedLabel String

  // Representa disponibilidade definitiva do assento.
  // Bloqueios temporários serão controlados através
  // das sessões de checkout.
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventSectorModality EventSectorModality @relation(fields: [eventSectorModalityId], references: [id], onDelete: Cascade)

  tickets       Ticket[]
  checkoutItems CheckoutItem[]

  @@unique([eventSectorModalityId, normalizedLabel])
  @@index([eventSectorModalityId])
}

// ======================================================
// PEDIDOS
// ======================================================

model Order {
  id String @id @default(uuid())

  clientId String

  // APPROVED, REFUSED, CANCELLED
  status String @default("APPROVED")

  // Valores sempre em centavos.
  subtotalInCents Int

  // 1200 basis points = 12%.
  serviceFeeRateBps Int @default(1200)

  serviceFeeInCents Int
  totalInCents      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])

  tickets Ticket[]

  @@index([clientId])
}

// ======================================================
// INGRESSOS
// ======================================================

model Ticket {
  id String @id @default(uuid())

  orderId            String
  ticketBatchPriceId String

  // Opcional para PISTA e outras modalidades
  // controladas apenas por quantidade.
  seatId String?

  // Valor efetivamente pago.
  unitPriceInCents Int

  qrCodeHash String @unique

  // VALID, USED, CANCELLED
  status String @default("VALID")

  sharedToken String @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order            Order            @relation(fields: [orderId], references: [id])
  ticketBatchPrice TicketBatchPrice @relation(fields: [ticketBatchPriceId], references: [id])
  seat             Seat?            @relation(fields: [seatId], references: [id])

  @@index([orderId])
  @@index([ticketBatchPriceId])
  @@index([seatId])
}

// ======================================================
// SESSÕES DE CHECKOUT
// ======================================================
//
// Representam uma tentativa de compra antes da criação
// definitiva de Order e Ticket.
//
// QUANTITY:
//
// - não bloqueia estoque;
// - várias pessoas podem iniciar checkout;
// - disponibilidade real será validada apenas
//   na finalização da compra.
//
// SEAT:
//
// - o assento fica bloqueado internamente;
// - o bloqueio dura no máximo 10 minutos;
// - após a expiração, o assento poderá ser escolhido
//   por outro usuário.
// ======================================================

model CheckoutSession {
  id String @id @default(uuid())

  clientId String

  // ACTIVE, COMPLETED, EXPIRED, CANCELLED
  status String @default("ACTIVE")

  // Obrigatório para sessões que contenham assentos.
  // QUANTITY não precisa utilizar expiração como
  // mecanismo de bloqueio de estoque.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])

  items CheckoutItem[]

  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
}

// ======================================================
// ITENS DA SESSÃO DE CHECKOUT
// ======================================================
//
// QUANTITY:
//
// seatId = null
// quantity >= 1
//
// O registro representa somente intenção de compra.
// Não desconta nem bloqueia estoque.
//
// SEAT:
//
// seatId obrigatório
// quantity = 1
//
// Enquanto a CheckoutSession estiver ACTIVE e
// expiresAt ainda não tiver passado, o assento
// estará temporariamente indisponível para outros
// usuários.
//
// O estado temporário não será exibido ao usuário.
// ======================================================

model CheckoutItem {
  id String @id @default(uuid())

  checkoutSessionId  String
  ticketBatchPriceId String

  seatId String?

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkoutSession  CheckoutSession  @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  ticketBatchPrice TicketBatchPrice @relation(fields: [ticketBatchPriceId], references: [id])
  seat             Seat?            @relation(fields: [seatId], references: [id])

  @@index([checkoutSessionId])
  @@index([ticketBatchPriceId])
  @@index([seatId])
}
